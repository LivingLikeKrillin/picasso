#!/usr/bin/env bash
# buf를 Docker로 실행한다. 로컬 설치를 요구하지 않으며 CI와 같은 버전을 쓴다.
# Git Bash의 MSYS 경로 변환을 끄고 호스트 경로를 cygpath로 넘기지 않으면
# Docker가 'the working directory is invalid'로 거부한다.
set -euo pipefail

BUF_VERSION="${BUF_VERSION:-1.47.2}"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# 호출자의 현재 위치를 저장소 루트 기준 상대 경로로 바꾼다.
REL="$(realpath --relative-to="$REPO_ROOT" "$PWD" 2>/dev/null || echo ".")"

HOST_ROOT="$REPO_ROOT"
if command -v cygpath >/dev/null 2>&1; then
  HOST_ROOT="$(cygpath -m "$REPO_ROOT")"
fi

export MSYS_NO_PATHCONV=1
export MSYS2_ARG_CONV_EXCL='*'

# ★**컨테이너 안의 git 이 마운트된 저장소를 거부한다.** 러너에서 파일 소유자가
# 컨테이너의 사용자와 달라 git 이 *dubious ownership* 으로 멈추고, 검사 2번의
# `buf breaking --against ../.git#ref=...` 이 통째로 실패한다.
#
# **원격이 생기기 전까지 CI 가 돈 적이 없어 이 자리가 한 번도 안 드러났다** —
# 로컬(Windows·Docker Desktop)에서는 마운트가 root 소유로 보여 재현되지 않는다.
#
# ★**`GIT_CONFIG_*` 환경변수로는 못 고친다.** `safe.directory` 는 git 이
# *protected configuration*(시스템·전역 설정)에서만 읽는다 — 명령줄과
# `GIT_CONFIG_COUNT` 로 준 것은 **의도적으로 무시한다**(그러지 않으면 공격자가
# 주입할 수 있다). 첫 판이 그것으로 고치려다 CI 에서 같은 자리에 다시 걸렸다.
#
# 그래서 **시스템 설정 파일(`/etc/gitconfig`)로 마운트한다.** 컨테이너는 매번
# 버려지고 저장소 하나만 보이므로 `*` 로 둔다.
GITCONFIG="$(mktemp)"
printf '[safe]\n\tdirectory = *\n' > "$GITCONFIG"
GITCONFIG_HOST="$GITCONFIG"
if command -v cygpath >/dev/null 2>&1; then
  GITCONFIG_HOST="$(cygpath -m "$GITCONFIG")"
fi
trap 'rm -f "$GITCONFIG"' EXIT

# **`exec` 를 안 쓴다** — 임시 설정 파일을 지워야 하므로 종료코드를 받아 넘긴다.
docker run --rm \
  -v "${GITCONFIG_HOST}:/etc/gitconfig:ro" \
  -v "${HOST_ROOT}:/workspace" \
  -w "/workspace/${REL}" \
  "bufbuild/buf:${BUF_VERSION}" "$@"
