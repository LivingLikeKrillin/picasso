gradlew      text eol=lf
tools/buf    text eol=lf
*.sh         text eol=lf
gradlew.bat  text eol=crlf
*.jar        binary

# 게이트 시험이 픽스처를 문자열로 치환한다. CRLF로 체크아웃되면
# 줄바꿈을 담은 치환이 빗나가고 음성 시험이 조용히 통과한다.
*.json       text eol=lf

# 인계본은 줄 단위 기록이다. CRLF 로 체크아웃되면 받는 쪽이 줄 끝에 캐리지리턴을
# 달고 읽거나, 줄 수를 세는 코드가 빈 줄을 하나 더 본다.
*.jsonl      text eol=lf
